# PostgreSQL (development only — copy to .env and set values locally)
POSTGRES_USER=studio_dev
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=studio_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API (optional overrides)
API_PORT=3000
MONITOR_DATA_SOURCE=mock
SOURCE_TIMEZONE=Asia/Shanghai

# Mock historical CSV roots (host paths — mount read-only in Compose)
MONITOR_BACKEND_DATA_ROOT=
MONITOR_FRONTEND_DATA_ROOT=
