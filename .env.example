# PostgreSQL credentials (copy to .env — do not commit)
POSTGRES_USER=studio_dev
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=studio_dev

# Host tools / bare-metal API (only when using docker-compose.dev-postgres.example.yml or local PG)
POSTGRES_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
# POSTGRES_PORT is the server port (5432 inside Compose; same on loopback when dev override is used)
POSTGRES_PORT=5432

# Compose project names (use -p flag; do not create per-WP/per-run project names):
#   Production steady state:  docker compose -p bili-prod ...
#   Dev/test hot reload:      docker compose -p bili-test -f docker-compose.dev.yml ...

# API (optional overrides — dev bare-metal / docker-compose.dev.yml api service)
API_PORT=3000

# Production unified app (docker-compose.yml maps APP_PORT on host → container 3000)
APP_PORT=8080
MONITOR_DATA_SOURCE=mock
SOURCE_TIMEZONE=Asia/Shanghai

# Collector. offline is the default and does not need a secret.
# bilibili mode refuses to start unless COLLECTOR_SECRET_KEY is 32 bytes, base64.
COLLECTOR_PROVIDER=offline
COLLECTOR_INSTANCE_ID=collector-1
COLLECTOR_SECRET_KEY=
COLLECTOR_MIN_INTERVAL_MS=1500
COLLECTOR_MAX_JITTER_MS=800
COLLECTOR_MAX_REQUESTS_PER_MINUTE=20
COLLECTOR_DRY_RUN=0
COLLECTOR_HTTP_TIMEOUT_MS=10000
COLLECTOR_TIER1_MAX_DAYS=3
COLLECTOR_TIER1_MINUTES=15
COLLECTOR_TIER2_MAX_DAYS=14
COLLECTOR_TIER2_MINUTES=120
COLLECTOR_TIER3_MINUTES=360
COLLECTOR_CREATOR_INTERVAL_MINUTES=240

# Offline mock tree (host path mounted read-only at /mock-data in Compose):
#   backend/  frontend/  assets/ (assets optional — missing => placeholder-only covers)
MOCK_DATA_ROOT=
# Set by Compose when assets/ exists; leave empty locally unless serving files from disk
MONITOR_ASSETS_ROOT=

# Web dev-server only: where Vite proxies /api (Compose sets http://api:3000 on the web service)
# VITE_API_PROXY_TARGET=http://localhost:3000
